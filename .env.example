# ============================================================
# Google OAuth 2.0 Client Configuration - Template
# ============================================================
# Hướng dẫn: Sao chép file này thành .env và dán Google Client ID vào bên dưới.
# Lấy Client ID tại: https://console.cloud.google.com/apis/credentials

VITE_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_CLIENT_ID=

# Google Gemini API Key cho Tier 1 Geometry Compiler
VITE_GEMINI_API_KEY=
REACT_APP_GEMINI_API_KEY=

